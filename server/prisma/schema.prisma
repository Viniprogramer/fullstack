generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  HOST
  ADMIN
}
enum BookingStatus {
  CONFIRMED
  CANCELLED
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role @default(CUSTOMER)
  avatar String
  properties Property[]
  bookings Booking[]
  favorites Favorite[]
  createdAt DateTime @default(now())
}
model Property {
  id String @id @default(cuid())
  title String
  city String
  state String
  country String @default("Brasil")
  price Float
  guests Int
  bedrooms Int
  beds Int
  rating Float @default(5)
  reviews Int @default(0)
  image String
  category String
  description String
  hostId String
  host User @relation(fields:[hostId],references:[id],onDelete:Cascade)
  bookings Booking[]
  favorites Favorite[]
  createdAt DateTime @default(now())
}
model Booking {
  id String @id @default(cuid())
  checkIn DateTime
  checkOut DateTime
  guests Int
  total Float
  status BookingStatus @default(CONFIRMED)
  userId String
  propertyId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Favorite {
  id String @id @default(cuid())
  userId String
  propertyId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
  @@unique([userId,propertyId])
}